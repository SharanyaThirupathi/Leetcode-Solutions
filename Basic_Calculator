 
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

int calculate(char* s) 
{
    int len = strlen(s);
    
    
    int* stack = (int*)malloc(sizeof(int) * len);
    int top = -1; 
    int result = 0;   
    int sign = 1;     
    long long number = 0; 
    
    for (int i = 0; i < len; i++) 
    {
        char c = s[i];
        
        if (isdigit(c)) 
        {
            
            number = number * 10 + (c - '0');
        } 
        else if (c == '+') 
        {
            
            result += sign * number;
            
            number = 0;
            sign = 1;
        } 
        else if (c == '-') 
        {
            
            result += sign * number;
            
            number = 0;
            sign = -1;
        } 
        else if (c == '(') 
        {
            
            stack[++top] = result;
            stack[++top] = sign;
            
            
            result = 0;
            sign = 1;
        } 
        else if (c == ')') 
        {
           
            result += sign * number;
            number = 0;
            
           
            int saved_sign = stack[top--];
            result *= saved_sign;
            
           
            int saved_result = stack[top--];
            result += saved_result;
        }
    }
    result+=sign*number;
    return result;
}
